<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            style="@style/AppText.Heading1"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/version_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AppText.Caption"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_description"
            style="@style/AppText.Body1"
            android:layout_marginBottom="20dp" />

        <!-- Status card: one state with its next step -->
        <LinearLayout
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AppCard"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_header"
                android:importantForAccessibility="no"
                style="@style/AppText.Label"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/status_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                style="@style/AppText.Heading2"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                style="@style/AppText.Body2"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_status_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AppButton.Primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/status_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AppText.Feedback"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Current edge zone configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AppCard"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/config_header"
                style="@style/AppText.Heading3"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/current_configuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/AppText.Body2"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_configure_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_configure_area"
                style="@style/AppButton.Secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/features_header"
            style="@style/AppText.Heading3"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/features_list"
            style="@style/AppText.Body2"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>
</ScrollView>
