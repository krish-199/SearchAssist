<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Padded for system bars and capped in width (see applySystemBarInsets) -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/screen_info"
            layout="@layout/screen_info" />

        <include
            android:id="@+id/screen_config"
            layout="@layout/screen_config"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Full-screen live preview of the edge zones, shown on the config screen -->
    <com.krishdev.searchassist.ScreenOverlayPreview
        android:id="@+id/screen_overlay_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

</FrameLayout>
