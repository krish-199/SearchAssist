<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:id="@+id/intro_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/sa" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/intro_title"
            style="@style/AppText.Heading1"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro_message"
            style="@style/AppText.Body1"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <!-- Accessibility disclosure -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AppCard"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/intro_disclosure_header"
                style="@style/AppText.Heading3"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/intro_disclosure"
                style="@style/AppText.Body2"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/intro_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AppText.Body1"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_intro_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AppButton.Primary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_intro_skip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_skip"
            style="@style/AppButton.Ghost" />

    </LinearLayout>
</ScrollView>
